# Maya AI — configuration template.
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file (it is git-ignored).
#
# NOTE: The previously committed live keys have been REVOKED.
#       Generate fresh keys and paste them locally only.

# --- LLM provider ---
# Gemini key from https://aistudio.google.com  (or OpenRouter/NVIDIA/Groq/OpenAI)
GEMINI_API_KEY=
GEMINI_API_PROVIDER=gemini
GEMINI_ACTIVE_MODEL=gemini-3.1-flash-lite

# --- Optional voice (leave blank to use free Edge TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Optional integrations (leave blank to disable) ---
# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=
# Spotify (music playback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Internal admin/dev key for protected debug routes
MAYA_ADMIN_KEY=
